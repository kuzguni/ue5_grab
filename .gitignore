# Generated Unreal output, including plugin output
Binaries/
DerivedDataCache/
Intermediate/
Saved/
*.log

# Local editor and agent settings
/.claude/settings.local.json
/.codex/
/.cursor/
/.gemini/
/.mcp.json
/.vscode/
.idea/
.vs/

# IDE projects generated at the Unreal project root
/*.sln
/*.vcxproj
/*.vcxproj.filters
/*.vcproj
/*.xcodeproj/
/*.xcworkspace/
/compile_commands.json

# Per-user IDE state
*.csproj.user
*.suo
*.sln.docstates
*.vcxproj.user
*.vcproj.user
*.VC.db
*.VC.opendb
*.sln.iml
xcuserdata/

# Local Python bytecode from Unreal editor scripts
__pycache__/
*.py[cod]

# OS metadata
Thumbs.db
Desktop.ini
.DS_Store

# Local project resources and notes
/ProjectResources/
*.[mM][dD]
